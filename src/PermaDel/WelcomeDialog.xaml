<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="PermaDel.WelcomeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="Welcome to PermaDel"
    PrimaryButtonText="Get started"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <Style x:Key="StepGlyphStyle" TargetType="FontIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="StepTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
    </ContentDialog.Resources>

    <StackPanel Spacing="20">
        <TextBlock
            TextWrapping="Wrap"
            Text="PermaDel permanently destroys files and folders, so they can't be brought back with undelete or file recovery tools." />

        <Grid ColumnSpacing="14" RowSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <FontIcon Glyph="&#xE8B7;" Style="{StaticResource StepGlyphStyle}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="Choose what to destroy" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Style="{StaticResource StepTextStyle}"
                    Text="Browse your drives and add files or folders to the shred list, or drag them in. In File Explorer, right-click them and choose Shred with PermaDel." />
            </StackPanel>

            <FontIcon Grid.Row="1" Glyph="&#xE8EE;" Style="{StaticResource StepGlyphStyle}" />
            <StackPanel Grid.Row="1" Grid.Column="1">
                <TextBlock Text="Pick the number of passes" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Style="{StaticResource StepTextStyle}" Text="Each pass overwrites every byte with random data. More passes take longer." />
            </StackPanel>

            <FontIcon Grid.Row="2" Glyph="&#xE74D;" Style="{StaticResource StepGlyphStyle}" />
            <StackPanel Grid.Row="2" Grid.Column="1">
                <TextBlock Text="Shred" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock
                    Style="{StaticResource StepTextStyle}"
                    Text="PermaDel asks you to confirm and, if turned on, to verify it's you. It then overwrites each file, renames it and deletes it." />
            </StackPanel>
        </Grid>

        <InfoBar
            IsOpen="True"
            IsClosable="False"
            Severity="Warning"
            Title="There's no undo"
            Message="Shredded items can't be recovered, not even by PermaDel. Copies can survive on SSDs, in backups and in cloud-synced folders." />

        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
            PermaDel is free, open-source software provided as is, without warranty. By using it, you agree to the
            <Hyperlink NavigateUri="https://github.com/lukastojiljkovic/PermaDel/blob/main/TERMS.md">Terms of Use</Hyperlink>. It doesn't collect any data; see the
            <Hyperlink NavigateUri="https://github.com/lukastojiljkovic/PermaDel/blob/main/PRIVACY.md">privacy statement</Hyperlink>.
        </TextBlock>

        <CheckBox x:Name="DontShowAgainBox" Content="Don't show this again" />
    </StackPanel>
</ContentDialog>
